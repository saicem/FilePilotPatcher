# Operating-system and editor state
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp
*.tmp

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# C/C++ build products generated by patcher/build_patch.ps1
/patcher/*.dll
/patcher/*.exp
/patcher/*.lib
/patcher/*.obj
/patcher/*.pdb
/patcher/*.ilk
/patcher/*.exe
/patcher/vendor/
/patcher/*.res

# Runtime diagnostics and visual captures
/patcher/*.log
!/patcher/selection_test/SECOND_TARGET.log
/patcher/*.png
/patcher/layout.json

# Keep the named release artifacts; ad-hoc builds remain local.
/binaries/release/*.exe
!/binaries/release/FPilot-open-location-tab-merge.exe
!/binaries/release/FPilot-all-patches.exe
!/binaries/release/FPilot-0.8.5-open-location-tab-merge.exe
!/binaries/release/FPilot-0.8.5-all-patches.exe
/binaries/release/dialogs/

# Ghidra per-user and transient state
/ghidra/project/*.lock
/ghidra/project/*.lock~
/ghidra/project/*.rep/user/
/ghidra/project/*.rep/projectState
/ghidra/project/*.rep/**/~index.bak
/ghidra/project/*.rep/**/~journal.bak
